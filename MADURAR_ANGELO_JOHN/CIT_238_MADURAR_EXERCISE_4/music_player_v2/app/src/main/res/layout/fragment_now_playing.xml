<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spotify_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Album art -->
        <FrameLayout
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/album_art_bg" />

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_headphones"
                android:alpha="0.4"
                android:contentDescription="@string/cd_album_art" />

        </FrameLayout>

        <!-- Song title & artist -->
        <TextView
            android:id="@+id/tvNowPlayingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a Song"
            android:textColor="@color/spotify_white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="start"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvNowPlayingArtist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SoundHelix"
                android:textColor="@color/spotify_light_gray"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnFavorite"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_favorite_border"
                android:contentDescription="Favorite"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Status text -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stopped"
            android:textColor="@color/spotify_light_gray"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <!-- Song List (Now Playing Queue) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Queue"
            android:textColor="@color/spotify_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNowPlayingQueue"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>

</ScrollView>
